---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="glass my-auto rounded-[1.75rem] px-6 py-10 text-center">
    <h1 class="text-[1.75rem] leading-tight font-bold tracking-[-0.022em]">Nothing here</h1>
    <p class="mt-2 text-[1.0625rem] leading-[1.45] text-ink-soft">This page doesn't exist, or it moved.</p>
    <a href="/" class="mt-6 inline-block rounded-full bg-(--press) px-5 py-2.5 font-semibold text-accent-ink">Back to infe.dev</a>
  </section>
</Base>

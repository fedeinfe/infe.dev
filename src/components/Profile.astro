---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.jpg";
import { profile } from "../links";
import SocialIcon from "./SocialIcon.astro";
---

<header class="glass rounded-[1.75rem] px-6 pt-8 pb-6 text-center" data-refract>
  <svg class="lens-defs" aria-hidden="true">
    <filter id="lens" color-interpolation-filters="sRGB">
      <feImage x="0" y="0" width="100%" height="100%" result="map"></feImage>
      <feDisplacementMap in="SourceGraphic" in2="map" scale="-90" xChannelSelector="R" yChannelSelector="B"></feDisplacementMap>
    </filter>
  </svg>
  <span class="siri-ring mx-auto block size-fit">
    <Image src={avatar} alt="" width={96} height={96} densities={[1, 2, 3]} loading="eager" class="size-24 rounded-full object-cover" />
  </span>
  <h1 class="mt-4 text-[1.75rem] leading-tight font-bold tracking-[-0.022em]">{profile.name}</h1>
  <p class="mx-auto mt-2 max-w-[21rem] text-[1.0625rem] leading-[1.45] text-ink-soft">{profile.bio}</p>
  <ul class="mt-5 flex justify-center gap-3" role="list">
    {
      profile.socials.map((social) => (
        <li>
          <a
            href={social.href}
            {...(social.href.startsWith("mailto:") ? {} : { target: "_blank", rel: "noopener noreferrer" })}
            aria-label={social.label}
            class="grid size-11 place-items-center rounded-full bg-(--press) transition-transform duration-150 ease-out active:scale-[0.94]"
          >
            <SocialIcon name={social.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</header>

---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import { isGroup, type TreeNode } from "../links";
import Icon from "./Icon.astro";

interface Props {
  nodes: TreeNode[];
  /** Shared by sibling groups so the browser keeps only one of them open. */
  path?: string;
}

const { nodes, path = "tree" } = Astro.props;
const isRoot = path === "tree";
---

<ul class="tree" role="list">
  {
    nodes.map((node, index) => {
      const label = (
        <>
          {node.icon && <Icon icon={node.icon} nested={!isRoot} />}
          <span class="min-w-0 flex-1">
            <span class:list={["block text-[1.0625rem] leading-snug tracking-[-0.01em]", isRoot ? "font-semibold" : "font-medium"]}>
              {node.title}
            </span>
            {node.description && <span class="block text-[0.8125rem] leading-snug text-ink-soft">{node.description}</span>}
          </span>
        </>
      );

      return (
        <li>
          {isGroup(node) ? (
            <details class="group" name={path}>
              <summary class="row">
                {label}
                <ChevronRight class="chevron flex-none text-accent-ink" size={18} stroke-width={2.25} aria-hidden="true" />
              </summary>
              <div class="children">
                <Astro.self nodes={node.children} path={`${path}-${index}`} />
              </div>
            </details>
          ) : (
            <a class="row" href={node.href} target="_blank" rel="noopener noreferrer">
              {label}
              <ArrowUpRight class="flex-none text-accent-ink" size={18} stroke-width={2.25} aria-hidden="true" />
            </a>
          )}
        </li>
      );
    })
  }
</ul>
